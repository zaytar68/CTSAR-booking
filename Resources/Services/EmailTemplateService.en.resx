  <!-- Welcome email -->
  <data name="WelcomeEmailSubject" xml:space="preserve">
    <value>CTSAR - Welcome! Create your password</value>
  </data>
  <data name="WelcomeEmailBody" xml:space="preserve">
    <value><![CDATA[
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {{ font-family: Arial, sans-serif; line-height: 1.6; color: #333; }}
        .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
        .header {{ background-color: #1976d2; color: white; padding: 20px; text-align: center; }}
        .content {{ background-color: #f9f9f9; padding: 30px; }}
        .button {{ display: inline-block; padding: 12px 24px; background-color: #1976d2; color: white; text-decoration: none; border-radius: 4px; margin: 20px 0; }}
        .footer {{ text-align: center; padding: 20px; font-size: 12px; color: #666; }}
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Welcome to CTSAR!</h1>
        </div>
        <div class="content">
            <p>Hello {0} {1},</p>
            <p>Your account has been successfully created. To start using the reservation application, you must first create your password.</p>
            <p>Click the button below to set your password:</p>
            <p style="text-align: center;">
                <a href="{2}" class="button">Create my password</a>
            </p>
            <p>This link is valid for 48 hours.</p>
            <p>If you did not request the creation of this account, you can ignore this email.</p>
            <p>Best regards,<br/>The CTSAR Team</p>
        </div>
        <div class="footer">
            <p>This is an automated email, please do not reply.</p>
        </div>
    </div>
</body>
</html>
]]></value>
  </data>

