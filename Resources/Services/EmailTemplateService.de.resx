  <!-- Willkommens-E-Mail -->
  <data name="WelcomeEmailSubject" xml:space="preserve">
    <value>CTSAR - Willkommen! Erstellen Sie Ihr Passwort</value>
  </data>
  <data name="WelcomeEmailBody" xml:space="preserve">
    <value><![CDATA[
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {{ font-family: Arial, sans-serif; line-height: 1.6; color: #333; }}
        .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
        .header {{ background-color: #1976d2; color: white; padding: 20px; text-align: center; }}
        .content {{ background-color: #f9f9f9; padding: 30px; }}
        .button {{ display: inline-block; padding: 12px 24px; background-color: #1976d2; color: white; text-decoration: none; border-radius: 4px; margin: 20px 0; }}
        .footer {{ text-align: center; padding: 20px; font-size: 12px; color: #666; }}
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Willkommen bei CTSAR!</h1>
        </div>
        <div class="content">
            <p>Hallo {0} {1},</p>
            <p>Ihr Konto wurde erfolgreich erstellt. Um die Reservierungsanwendung zu nutzen, müssen Sie zunächst Ihr Passwort erstellen.</p>
            <p>Klicken Sie auf die Schaltfläche unten, um Ihr Passwort festzulegen:</p>
            <p style="text-align: center;">
                <a href="{2}" class="button">Mein Passwort erstellen</a>
            </p>
            <p>Dieser Link ist 48 Stunden gültig.</p>
            <p>Wenn Sie die Erstellung dieses Kontos nicht beantragt haben, können Sie diese E-Mail ignorieren.</p>
            <p>Mit freundlichen Grüßen,<br/>Das CTSAR-Team</p>
        </div>
        <div class="footer">
            <p>Dies ist eine automatische E-Mail, bitte antworten Sie nicht darauf.</p>
        </div>
    </div>
</body>
</html>
]]></value>
