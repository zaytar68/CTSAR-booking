@*
====================================================================
CreateUserDialog.razor : Dialogue de création d'utilisateur
====================================================================
Ce dialogue permet aux administrateurs de créer un nouvel utilisateur.
Utilise les composants MudBlazor pour une interface moderne et réactive.
*@

@using System.ComponentModel.DataAnnotations
@using CTSAR.Booking.DTOs
@using CTSAR.Booking.Constants
@using CTSAR.Booking.Services
@using MudBlazor

@inject UserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid>
                @* ======================================================== *@
                @* INFORMATIONS PERSONNELLES                                *@
                @* ======================================================== *@
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="me-2" />
                        Informations personnelles
                    </MudText>
                    <MudDivider />
                </MudItem>

                @* Prénom *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Prenom"
                                  Label="Prénom"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Le prénom est obligatoire"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true"
                                  HelperText="Prénom de l'utilisateur" />
                </MudItem>

                @* Nom *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Nom"
                                  Label="Nom"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Le nom est obligatoire"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true"
                                  HelperText="Nom de famille de l'utilisateur" />
                </MudItem>

                @* Email *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Adresse email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="L'email est obligatoire"
                                  InputType="InputType.Email"
                                  Validation="@(new EmailAddressAttribute() { ErrorMessage = "L'email n'est pas valide" })"
                                  Immediate="true"
                                  HelperText="Sera utilisé comme identifiant de connexion" />
                </MudItem>

                @* Téléphone *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  Label="Téléphone"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Telephone"
                                  HelperText="Non stocké actuellement"
                                  Disabled="true"
                                  Clearable="false" />
                </MudItem>

                @* Langue *@
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.PreferenceLangue"
                               Label="Langue préférée"
                               Variant="Variant.Outlined"
                               Required="true"
                               HelperText="Langue de l'interface">
                        <MudSelectItem Value="@("fr")">🇫🇷 Français</MudSelectItem>
                        <MudSelectItem Value="@("de")">🇩🇪 Allemand</MudSelectItem>
                        <MudSelectItem Value="@("en")">🇬🇧 Anglais</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* ======================================================== *@
                @* RÔLES                                                    *@
                @* ======================================================== *@
                <MudItem xs="12" Class="mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Class="me-2" />
                        Rôles et permissions
                    </MudText>
                    <MudDivider />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Sélectionnez au moins un rôle pour cet utilisateur :
                    </MudText>

                    @* Administrateur *@
                    <MudCheckBox @bind-Value="@_isAdministrateur"
                                 Color="Color.Error"
                                 Dense="true"
                                 Label="Administrateur - Accès complet à toutes les fonctionnalités" />

                    @* Moniteur *@
                    <MudCheckBox @bind-Value="@_isMoniteur"
                                 Color="Color.Warning"
                                 Dense="true"
                                 Label="Moniteur - Peut valider et gérer les réservations" />

                    @* Membre *@
                    <MudCheckBox @bind-Value="@_isMembre"
                                 Color="Color.Info"
                                 Dense="true"
                                 Label="Membre - Peut créer et consulter ses réservations" />

                    @if (!_isAdministrateur && !_isMoniteur && !_isMembre)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">
                            Au moins un rôle doit être sélectionné
                        </MudAlert>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Cancel">
            Annuler
        </MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(!_formIsValid || _processing || (!_isAdministrateur && !_isMoniteur && !_isMembre))">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Création...</span>
            }
            else
            {
                <span>Créer l'utilisateur</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ================================================================
    // PARAMÈTRES DU DIALOGUE
    // ================================================================

    [CascadingParameter]
    public MudBlazor.IDialogReference? DialogRef { get; set; }

    // ================================================================
    // VARIABLES D'ÉTAT
    // ================================================================

    /// <summary>
    /// Référence au formulaire MudForm.
    /// Permet de valider le formulaire avant la soumission.
    /// </summary>
    private MudForm _form = null!;

    /// <summary>
    /// Indique si le formulaire est valide.
    /// Activé/désactive le bouton de soumission.
    /// </summary>
    private bool _formIsValid;

    /// <summary>
    /// Modèle de données pour le nouvel utilisateur.
    /// </summary>
    private CreateUserDto _model = new();

    /// <summary>
    /// Indique si une opération est en cours.
    /// Affiche un spinner pendant la création.
    /// </summary>
    private bool _processing = false;

    /// <summary>
    /// Indique si l'utilisateur a le rôle Administrateur.
    /// </summary>
    private bool _isAdministrateur = false;

    /// <summary>
    /// Indique si l'utilisateur a le rôle Moniteur.
    /// </summary>
    private bool _isMoniteur = false;

    /// <summary>
    /// Indique si l'utilisateur a le rôle Membre.
    /// Par défaut true (tous les utilisateurs sont au moins Membre).
    /// </summary>
    private bool _isMembre = true;

    // ================================================================
    // INITIALISATION
    // ================================================================

    protected override void OnInitialized()
    {
        // Définir les valeurs par défaut
        _model.PreferenceLangue = "fr";
    }

    // ================================================================
    // ACTIONS
    // ================================================================

    /// <summary>
    /// Annule la création et ferme le dialogue.
    /// </summary>
    private void Cancel()
    {
        DialogRef?.Close(DialogResult.Cancel());
    }

    /// <summary>
    /// Soumet le formulaire et crée l'utilisateur.
    /// </summary>
    private async Task Submit()
    {
        // Valide le formulaire
        await _form.Validate();

        if (!_formIsValid)
        {
            Snackbar.Add("Veuillez corriger les erreurs du formulaire", Severity.Error);
            return;
        }

        // Vérifie qu'au moins un rôle est sélectionné
        if (!_isAdministrateur && !_isMoniteur && !_isMembre)
        {
            Snackbar.Add("Au moins un rôle doit être sélectionné", Severity.Error);
            return;
        }

        try
        {
            _processing = true;

            // Construit la liste des rôles
            _model.Roles = new List<string>();
            if (_isAdministrateur) _model.Roles.Add(RoleConstants.Administrateur);
            if (_isMoniteur) _model.Roles.Add(RoleConstants.Moniteur);
            if (_isMembre) _model.Roles.Add(RoleConstants.Membre);

            // Appelle le service pour créer l'utilisateur
            var (success, message) = await UserService.CreateUserAsync(_model);

            if (success)
            {
                // Fermer le dialogue en cas de succès (le message sera affiché par la page parente)
                DialogRef?.Close(DialogResult.Ok(message ?? "Utilisateur créé avec succès"));
            }
            else
            {
                Snackbar.Add(message ?? "Erreur lors de la création", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur inattendue : {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}
